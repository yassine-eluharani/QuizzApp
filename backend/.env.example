PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/cloudprep

# RevenueCat secret API key (from RC dashboard → API Keys → Secret keys)
REVENUECAT_SECRET_KEY=sk_...

# RevenueCat entitlement identifier (must match what you set in RC dashboard)
REVENUECAT_ENTITLEMENT_ID=pro

# Admin API key for sending push notifications (generate any random string)
ADMIN_API_KEY=your-secret-admin-key
