# CloudPrep API — example env file. Copy to .env and fill in.
# DO NOT commit a real .env. Production should source these from a secret store.

# ---- Required ----
DATABASE_URL=postgresql://cloudprep:CHANGE_ME@db:5432/cloudprep

# RevenueCat secret API key (server). Found in RevenueCat dashboard → API keys → Secret.
REVENUECAT_SECRET_KEY=sk_REPLACE_ME

# Long random string. Generate with: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_64_HEX_CHARS

# Postgres credentials (used by docker-compose to provision the local DB)
POSTGRES_DB=cloudprep
POSTGRES_USER=cloudprep
POSTGRES_PASSWORD=CHANGE_ME

# ---- Optional ----
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# RevenueCat entitlement identifier (default: pro)
REVENUECAT_ENTITLEMENT_ID=pro

# RevenueCat webhook authorization header value.
# Set the same value in RevenueCat dashboard → Integrations → Webhooks → Authorization header.
# Generate with: openssl rand -hex 32
REVENUECAT_WEBHOOK_AUTH=

# Comma-separated list of allowed CORS origins. Expo (exp://) is allow-listed automatically.
ALLOWED_ORIGINS=https://your-domain.example,https://staging.your-domain.example

# Postgres pool sizing
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
