{
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REVENUECAT_APPLE_API_KEY": "",
        "REVENUECAT_GOOGLE_API_KEY": ""
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview3": {
      "developmentClient": true
    },
    "production": {
      "android": {
        "enableProguardInReleaseBuilds": true
      },
      "env": {
        "REVENUECAT_APPLE_API_KEY": "",
        "REVENUECAT_GOOGLE_API_KEY": ""
      }
    }
  }
}
